# Campus LMS Lite — environment configuration
# Copy to .env and adjust. Never commit a real .env file.

# development | production | test
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Public URL users open (used in activation / reset links and emails).
# Development: the Vite dev server. Production: your HTTPS domain.
APP_URL=http://localhost:5173

# Database.
#   PostgreSQL (production):  postgres://lms:CHANGE_ME@db-host:5432/lms
#   Embedded PGlite (dev/demo, stored on disk relative to server/): pglite:./data/pglite
DATABASE_URL=pglite:./data/pglite

# Private file storage directory (outside any web root). Relative to server/.
FILE_STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Optional S3-compatible object storage (Cloudflare R2, Amazon S3, MinIO...). Use it on hosts whose disk
# is wiped on restart. Set all four, or leave all empty to use FILE_STORAGE_DIR.
# Cloudflare R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Sessions
SESSION_TTL_HOURS=12
# Defaults to true when NODE_ENV=production. Set true whenever served over HTTPS.
# COOKIE_SECURE=true
# Set true when running behind a reverse proxy / load balancer that sets X-Forwarded-*.
TRUST_PROXY=false
AUTH_RATE_LIMIT_PER_MINUTE=10

# Email (optional). When SMTP_URL is empty, no email is sent and the UI says so.
# Example: smtps://user:password@smtp.example.edu:465
SMTP_URL=
MAIL_FROM=Campus LMS Lite <no-reply@example.edu>

LOG_LEVEL=info

# Development seed only (npm run db:seed). Password for every demo account.
# Demo data must never be loaded into production.
SEED_PASSWORD=DemoPass-2026
